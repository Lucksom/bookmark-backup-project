{
  "manifest_version": 2,
  "key": "",
  "name": "Bookmark Cloud Backup (Legacy)",
  "version": "1.0",
  "description": "Backup and restore bookmarks to Google Drive or offline files.",
  "permissions": [
    "bookmarks",
    "identity",
    "storage",
    "downloads",
    "alarms",
    "https://*.googleapis.com/*"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "scripts": [
      "shared-scripts/auth.js",
      "shared-scripts/drive.js",
      "shared-scripts/bookmarks.js",
      "background.js"
    ],
    "persistent": false
  },
  "oauth2": {
    "client_id": "893630697154-hip70mbn0l83r8gb8u3samhj5h4gku0l.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}

{
  "manifest_version": 3,
  "name": "Bookmark Cloud Backup",
  "version": "1.44",
  "description": "Backup and restore bookmarks to Google Drive or offline files.",
  "permissions": [
    "bookmarks",
    "identity",
    "storage",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "893630697154-hip70mbn0l83r8gb8u3samhj5h4gku0l.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
